<li class="interview">
	<a href="{{ entry.url }}">
		<div class="post-link-photo">
			<img src="{{ entry.data.photo }}" width="80" height="80" alt="{{ entry.data.name }}">
		</div>
		<div class="post-link-wrap">
			<div class="post-link">
				<h2>{{ entry.data.heading }}</h2>

				<p class="about">
					<span>{{ entry.data.name }}</span>
					<time datetime="{{ entry.date | isoDate }}">
						{{ entry.data.date | readableDate }}
					</time>
					<span class="meta">#{{ entry.data.title }}</span>
				</p>
			</div>
			{{ entry.data.intro | cleanAndTrim }}
		</div>
	</a>
</li>
