<div class="who" itemscope itemtype="http://schema.org/Person">
	<div class="">
		<img itemprop="image" src="{{ photo }}" width="80" height="80" alt="{{ name }}">
	</div>
	<div class="">
		<h2 itemprop="name">{{ name }}</h2>
		{%- if social %}
			<ul class="social">
			{%- for link in social %}
				<li>
					{%- if link.type == 'website' %}
