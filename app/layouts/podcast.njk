---
layout: default.njk
eleventyComputed:
  seoPageTitle: "{{ title }} ({{ episode }})"
  seoPageDescription: "{{ description | default: intro }}"
  socialMediaPhoto: "{{ ogImage }}"
---
<div class="interviewSingle podcastSingle">

	<p class="meta">
		<span>#{{ episode }}</span>
		<time datetime="{{ date | isoDate }}">
			{{ date | readableDate }}
		</time>
	</p>

	<h1>{{ title }}</h1>

	<div class="intro">
		{{ intro | safe }}
	</div>
	<div class="podcastLinks">
		<p>Listen to <strong>{{ episode }}</strong> on:</p>
		<div>
			{%- if applePodcastsLink %}<a href="{{ applePodcastsLink }}" class="imageLink"><img src="/assets/img/podcasts/cta/applepodcasts-badge.svg" width="167" height="44" alt="Listen to {{ episode }} on Apple Podcasts"></a>{%- endif %}
			{%- if spotifyLink %}<a href="{{ spotifyLink }}" class="imageLink"><img src="/assets/img/podcasts/cta/spotify-badge.svg" width="167" height="44" alt="Listen to {{ episode }} on Spotify"></a>{%- endif %}
			{%- if amazonLink %}<a href="{{ amazonLink }}" class="imageLink"><img src="/assets/img/podcasts/cta/amazonmusic-badge.svg" width="167" height="44" alt="Listen to {{ episode }} on Amazon Music"></a>{%- endif %}
		</div>
		<p><small>Podcast player not here? <a href="/podcasts/subscriptions/">Check out our subscriptions page</a></small></p>
	</div>

	{%- if acastEpisode %}
		<iframe src="https://embed.acast.com/62d9b3f5f39c44001194bc1e/{{ acastEpisode }}?cover=false" title="Listen to {{ episode }}: {{ title }}" loading="lazy" frameBorder="0" width="100%" height="200px"></iframe>
	{%- endif %}

	<div class="people">
	{% for person in people %}
		{% include 'podcast-person-card.njk' %}
	{% endfor %}
	</div>

	<div>
		{{ content | safe }}

		{% include 'signup.njk' %}
	</div>
</div>
