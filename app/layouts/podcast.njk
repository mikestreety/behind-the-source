---
layout: default.njk
eleventyComputed:
  seoPageTitle: "{{ episode }}: {{ name }}"
  seoPageDescription: "{{ title | cleanAndTrim(15) }} - {{ name }} is interviewed for Behind the Source"
  socialMediaPhoto: "{{ ogImage }}"
---
<div itemscope itemtype="http://schema.org/PublicationIssue" class="interviewSingle podcastSingle">

	<p class="meta">
		<span itemprop="issueNumber">#{{ episode }}</span>
		<time datetime="{{ date }}" itemprop="datePublished">
			{{ date | readableDate }}
		</time>
	</p>

	<h1 itemprop="headline">{{ title }}</h1>

	<div class="intro" itemprop="abstract">
		{{ intro | safe }}

		<p class="cta">Listen to <strong>{{ episode }}</strong> on:
			{%- if applePodcastsLink %}<a href="{{ applePodcastsLink }}">Apple Podcasts</a>{%- endif %}
			{%- if spotifyLink %}<a href="{{ spotifyLink }}">Spotify</a>{%- endif %}
			{%- if googlePodcastsLink %}<a href="{{ googlePodcastsLink }}">Google Podcasts</a>{%- endif %}
			{%- if acastLink %}<a href="{{ acastLink }}">Acast</a>{%- endif %}
		</p>
	</div>


	{%- if acastEpisode %}
		<iframe src="https://embed.acast.com/62d9b3f5f39c44001194bc1e/{{ acastEpisode }}?cover=false" frameBorder="0" width="100%" height="110px"></iframe>
	{%- endif %}

	<div class="people">
	{% for person in people %}
		{% include 'podcast-person-card.njk' %}
	{% endfor %}
	</div>

	<div>
		{{ content | safe }}

		{% include 'signup.njk' %}
	</div>
</div>
