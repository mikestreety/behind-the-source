---
layout: default.njk
eleventyComputed:
  title: "{{ title }}: {{ name }}"
  seoPageTitle: "{% if seoTitleOverride %}{{ seoTitleOverride }}{% else %}Interview with {{ name }} ({{ page.fileSlug | upcase }}){% endif %}"
  seoPageDescription: "{{ description }}"
  socialMediaPhoto: "{{ ogImage }}"
---
<div class="interviewSingle">

	<p class="meta">
		<span>#{{ title }}</span>
		<time datetime="{{ date | isoDate }}">
			{{ date | readableDate }}
		</time>
	</p>

	<h1>{{ heading }}</h1>

	{% include 'person-card.njk' %}


	<div class="intro">{{ intro | safe }}</div>

	<div>
		{%- for item in body %}
			{%- if item.type == 'question' %}
			<dl class="interviewQuestion">
				<dt>{{ item.fields.question | safe }}</dt>
				<dd>
					{{ item.fields.answer | safe }}
				</dd>
			</dl>
			{%- endif %}
			{%- if item.type == 'pullquote' %}
			<div>
				<blockquote>
					<p>{{ item.fields.quote }}</p>
				</blockquote>
				<cite class="isHidden">{{ name }}</cite>
			</div>
			{%- endif %}
			{%- if item.type == 'rte' %}
			<div>{{ item.fields.text | safe }}</div>
			{%- endif %}
		{% endfor %}

		{% include 'signup.njk' %}
	</div>
	<p>If you enjoyed this interview, would you consider <a href="https://www.buymeacoffee.com/mikestreety">buying us a round</a>? Make sure you mention {{ name }} in the message and i'll make sure they get half. Thank you.</p>

	<nav class="entryNavigation">
		<h2>Other interviews</h2>
		<ol class="interviewListing">
		{% set previousPost = collections.interviews | getPreviousCollectionItem(page) %}
		{% if previousPost %}
			{% set entry = previousPost %}
			{% include 'entry-interview.njk' %}
		{% endif %}
		{% set nextPost = collections.interviews | getNextCollectionItem(page) %}
		{% if nextPost %}
			{% set entry = nextPost %}
			{% include 'entry-interview.njk' %}
		{% endif %}
		</ol>
	</nav>
</div>
