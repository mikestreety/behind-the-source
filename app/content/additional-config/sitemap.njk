---
permalink: /sitemap.xml
sitemapIgnore: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for item in collections.all %}
{%- if item.data.sitemapIgnore !== true and item.url and item.url.endsWith('/') and not item.data.draft %}
	<url>
		<loc>https://behindthesource.mikestreety.co.uk{{ item.url }}</loc>
		<lastmod>{{ item.date | isoDate }}</lastmod>
	</url>
{%- endif %}
{%- endfor %}
</urlset>
